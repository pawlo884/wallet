# --- Wallet (BudgetBakers) ---
# Wallet Web → Settings → API token (wymaga Premium)
WALLET_API_TOKEN=

# Konto domyślne: nazwa ("Ogólne") lub ID. Puste = konto PLN z największą liczbą rekordów.
DEFAULT_ACCOUNT=Ogólne
BASE_CURRENCY=PLN

# --- Claude ---
ANTHROPIC_API_KEY=
# claude-haiku-4-5 = tanio i szybko; claude-sonnet-5-5 / claude-opus-5-5 = lepiej z trudnymi paragonami
CLAUDE_MODEL=claude-haiku-4-5

# true = bot pokazuje szkic i czeka na ✅; false = zapisuje od razu (zostaje przycisk ↩️ Cofnij)
REQUIRE_CONFIRMATION=true

# --- Telegram (zostaw puste, żeby wyłączyć) ---
TELEGRAM_BOT_TOKEN=
# Twoje Telegram ID (napisz do bota /whoami). Kilka: 123,456
TELEGRAM_ALLOWED_USERS=

# --- Discord (zostaw puste, żeby wyłączyć) ---
DISCORD_BOT_TOKEN=
# Twoje Discord ID (napisz do bota !whoami w DM)
DISCORD_ALLOWED_USERS=
# Opcjonalnie: ID kanałów serwera, na których bot ma działać (oprócz DM)
DISCORD_CHANNEL_IDS=

# --- Płatności cykliczne (schedule.yaml) ---
# Godzina (czas lokalny), od której bot wysyła przypomnienia o terminach.
REMINDER_HOUR=9

# --- Mowa → tekst (lokalnie, faster-whisper; model pobiera się raz do wolumenu) ---
STT_ENABLED=true
# tiny / base / small / medium — większy = dokładniej, ale wolniej i więcej RAM
STT_MODEL=small
STT_THREADS=4

# --- Wyciągi z banku na maila bota (opcjonalnie; puste MAIL_USER = wyłączone) ---
# Osobna skrzynka tylko dla bota, np. nowe konto Gmail. Hasło: hasło aplikacji Google
# (Konto Google → Bezpieczeństwo → Weryfikacja dwuetapowa → Hasła aplikacji), nie zwykłe hasło.
MAIL_IMAP_HOST=imap.gmail.com
MAIL_USER=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
MAIL_POLL_MINUTES=10
# Tylko maile od tych nadawców są przetwarzane: Twój adres (ręczne przekazanie) i domena banku (filtr auto-przekazywania)
MAIL_ALLOWED_FROM=pawlo884@gmail.com,mbank.pl

# --- Prognoza (strona WWW w sieci NPM; założenia w config/forecast.yaml) ---
WEB_PORT=8080
# Publiczny adres strony prognozy (Proxy Host w NPM) — bot podaje go w /prognoza
FORECAST_URL=
