# --- Wallet (BudgetBakers) ---
# Wallet Web → Settings → API token (wymaga Premium)
WALLET_API_TOKEN=

# Konto domyślne: nazwa ("Ogólne") lub ID. Puste = konto PLN z największą liczbą rekordów.
DEFAULT_ACCOUNT=Ogólne
BASE_CURRENCY=PLN

# --- Claude ---
ANTHROPIC_API_KEY=
# claude-haiku-4-5 = tanio i szybko; claude-sonnet-5-5 / claude-opus-5-5 = lepiej z trudnymi paragonami
CLAUDE_MODEL=claude-haiku-4-5

# true = bot pokazuje szkic i czeka na ✅; false = zapisuje od razu (zostaje przycisk ↩️ Cofnij)
REQUIRE_CONFIRMATION=true

# --- Telegram (zostaw puste, żeby wyłączyć) ---
TELEGRAM_BOT_TOKEN=
# Twoje Telegram ID (napisz do bota /whoami). Kilka: 123,456
TELEGRAM_ALLOWED_USERS=

# --- Discord (zostaw puste, żeby wyłączyć) ---
DISCORD_BOT_TOKEN=
# Twoje Discord ID (napisz do bota !whoami w DM)
DISCORD_ALLOWED_USERS=
# Opcjonalnie: ID kanałów serwera, na których bot ma działać (oprócz DM)
DISCORD_CHANNEL_IDS=
